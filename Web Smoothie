.gate-btns .cta{flex:1 1 280px}
.gate-btns .alt{min-height:50px;padding:0 24px;font-weight:700}
.gate .hero .sub{margin:12px 0 16px}
.gate.leaving{animation:gateOut .55s cubic-bezier(.5,0,.8,.4) forwards;pointer-events:none}
