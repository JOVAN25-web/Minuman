/* ---------- voice search ---------- */
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
let rec=null,listening=false,voiceFinal='',voiceErr=false;
function setVoiceMsg(m){$('voiceMsg').textContent=m||'';}
function stopMic(){listening=false;$('mic').setAttribute('aria-pressed','false');}
function startVoice(){
  if(!SR)return;
  if(listening&&rec){try{rec.stop();}catch(e){}return;}
  voiceFinal='';voiceErr=false;
  try{rec=new SR();}catch(e){setVoiceMsg(t('voice.error'));return;}
  rec.lang=L().sr;rec.interimResults=true;rec.continuous=false;rec.maxAlternatives=1;
  rec.onstart=()=>{listening=true;$('mic').setAttribute('aria-pressed','true');setVoiceMsg(t('voice.listen'));};
  rec.onresult=e=>{
    let txt='';for(let i=0;i<e.results.length;i++)txt+=e.results[i][0].transcript+' ';
    txt=txt.trim().replace(/[.。!?？！،,]+$/,'');
    $('q').value=txt;state.q=txt;state.limit=24;renderResults();
    if(e.results[e.results.length-1].isFinal)voiceFinal=txt;
  };
  rec.onerror=e=>{
    const er=e.error;voiceErr=true;
    if(er==='not-allowed'||er==='service-not-allowed')setVoiceMsg(t('voice.denied'));
    else if(er==='no-speech')setVoiceMsg(t('voice.nospeech'));
    else if(er==='aborted')voiceErr=false;
    else setVoiceMsg(t('voice.error'));
  };
  rec.onend=()=>{
    stopMic();
    if(voiceFinal){setVoiceMsg(t('voice.heard',{q:voiceFinal}));addHist('q',voiceFinal);scrollToResults();}
    else if(!voiceErr)setVoiceMsg('');
  };
  try{rec.start();}catch(e){stopMic();setVoiceMsg(t('voice.error'));}
}
$('mic').addEventListener('click',startVoice);
if(!SR)$('mic').hidden=true;

