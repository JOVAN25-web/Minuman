<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SMOOSH</title>
<meta name="description" content="SMOOSH. Find ur dream smoothies. 150 smoothie recipes in 8 languages.">
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap">
<style>

/* Layout: hero panel with search, then menu cards, ingredient picker, and a live results grid. Colour comes from the six menu colours. */
:root{
  --bg:#FBF8FF; --surface:#FFFFFF; --surface-2:#F2ECFF; --ink:#1F1535; --ink-2:#5B5075; --line:#E3D9F5;
  --accent:#D1206A; --accent-ink:#FFFFFF; --focus:#5B3DF5; --shadow:0 8px 24px rgba(60,30,120,.10); --warn:#B42318;
  --c-orange:#FF8A1F; --c-green:#2EB86B; --c-berry:#7C4DFF; --c-nut:#B9772F; --c-pink:#E8458B; --c-yellow:#F2B600;
  --f-display:'Fredoka','Trebuchet MS',system-ui,sans-serif;
  --f-body:'Nunito',system-ui,-apple-system,'Segoe UI',sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#150E26; --surface:#20163A; --surface-2:#2B1F4D; --ink:#F4EEFF; --ink-2:#BDB0DA; --line:#3A2C63;
    --accent:#FF5C9D; --accent-ink:#1A0F2E; --focus:#A793FF; --shadow:0 8px 24px rgba(0,0,0,.35); --warn:#FF9A8A;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#150E26; --surface:#20163A; --surface-2:#2B1F4D; --ink:#F4EEFF; --ink-2:#BDB0DA; --line:#3A2C63;
  --accent:#FF5C9D; --accent-ink:#1A0F2E; --focus:#A793FF; --shadow:0 8px 24px rgba(0,0,0,.35); --warn:#FF9A8A;
  color-scheme:dark;
}

:root[data-theme="mangga"]{
  --bg:#FFF6E5; --surface:#FFFDF8; --surface-2:#FFE8BF; --ink:#3A2205; --ink-2:#765626; --line:#F0D6A2;
  --accent:#CC4A1B; --accent-ink:#FFFFFF; --focus:#5B3DF5; --shadow:0 8px 24px rgba(120,70,10,.14); --warn:#B42318;
  color-scheme:light;
}
:root[data-theme="matcha"]{
  --bg:#0C1B14; --surface:#143024; --surface-2:#1D4232; --ink:#EAF7EE; --ink-2:#A7C9B3; --line:#2D5642;
  --accent:#86E3AB; --accent-ink:#08210F; --focus:#C9F7DA; --shadow:0 8px 24px rgba(0,0,0,.4); --warn:#FF9A8A;
  color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{
  margin:0; background:var(--bg); color:var(--ink); font:400 16px/1.55 var(--f-body);
  overflow:hidden;
}
html,body{height:100%}
.app{display:flex;flex-direction:column;height:100%}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--bg)}
.wrap{max-width:1120px;margin:0 auto}
button{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance}

.topbar{position:relative;z-index:70;flex:none;width:100%;max-width:1120px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.logo{display:flex;align-items:center;gap:10px;font:700 1.6rem/1 var(--f-display);letter-spacing:.03em;text-decoration:none;color:var(--ink)}
.logo svg{width:34px;height:34px;flex:none}
.logo .o1{color:var(--c-orange)} .logo .o2{color:var(--c-green)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 18px;border-radius:999px;border:2px solid var(--line);background:var(--surface);cursor:pointer;font-weight:700}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.primary:hover{filter:brightness(1.06)}
.btn[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}

.hero{
  position:relative;overflow:hidden;border-radius:28px;padding:clamp(20px,5vw,48px);
  display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:28px;align-items:center;
  background:
    radial-gradient(60% 80% at 100% 0%,color-mix(in srgb,var(--c-orange) 30%,transparent),transparent 70%),
    radial-gradient(50% 70% at 0% 100%,color-mix(in srgb,var(--c-berry) 26%,transparent),transparent 70%),
    var(--surface-2);
}
.hero h1{font-weight:700;font-size:clamp(2.5rem,7.5vw,4.6rem);line-height:.98}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p{margin:14px 0 22px;max-width:46ch;color:var(--ink-2);font-size:1.05rem}
.search{display:flex;gap:10px;flex-wrap:wrap}
.search .field{flex:1 1 240px;min-width:0;position:relative}
.search input{width:100%;min-height:52px;padding-block:0;padding-inline:48px 58px;border-radius:999px;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:600 1rem var(--f-body)}
.search input::placeholder{color:var(--ink-2);opacity:.8}
.search svg{position:absolute;inset-inline-start:16px;top:50%;transform:translateY(-50%);width:22px;height:22px;color:var(--ink-2);pointer-events:none}
.try{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;align-items:center;color:var(--ink-2);font-weight:600;font-size:.92rem}
.try button{min-height:36px;padding:0 14px;border-radius:999px;border:0;cursor:pointer;font-weight:700;background:color-mix(in srgb,var(--c-berry) 18%,var(--surface));color:var(--ink)}
.try button:hover{background:color-mix(in srgb,var(--c-berry) 32%,var(--surface))}
.bubbles{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.bubbles span{aspect-ratio:1;max-width:100%;display:grid;place-items:center;border-radius:50%;font-size:clamp(1.8rem,5.5vw,3rem);background:color-mix(in srgb,var(--mc) 30%,var(--surface));animation:bob 4s ease-in-out infinite}
.bubbles span:nth-child(2n){animation-delay:-1.3s;transform:translateY(8px)}
.bubbles span:nth-child(3n){animation-delay:-2.4s}
@keyframes bob{50%{translate:0 -8px}}
@media (max-width:760px){.hero{grid-template-columns:minmax(0,1fr)}.bubbles{grid-template-columns:repeat(8,1fr)}.bubbles span{font-size:clamp(1.1rem,4.6vw,1.7rem)}}

section{margin-top:44px}
.sec-head{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:8px 20px;margin-bottom:16px}
.sec-head h2{font-size:clamp(1.5rem,3.6vw,2rem);font-weight:600}
.sec-head p{margin:2px 0 0;color:var(--ink-2);max-width:60ch}

.menus{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.menu-card{
  display:grid;gap:8px;align-content:start;text-align:start;padding:16px;cursor:pointer;border-radius:22px;
  background:color-mix(in srgb,var(--mc) 14%,var(--surface));
  border:2px solid color-mix(in srgb,var(--mc) 35%,var(--line));
  transition:transform .15s,box-shadow .15s;
}
.menu-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.menu-card[aria-pressed="true"]{border-color:var(--mc);box-shadow:0 0 0 4px color-mix(in srgb,var(--mc) 32%,transparent)}
.menu-card .disk{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;font-size:1.7rem;background:var(--mc)}
.menu-card h3{font-size:1.25rem;font-weight:600}
.menu-card p{margin:0;color:var(--ink-2);font-size:.93rem}
.menu-card .foot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:4px;font-weight:700;font-size:.9rem}
.menu-card .mini{letter-spacing:2px;font-size:1.05rem}
.menu-card .sel{font-size:.78rem;padding:2px 8px;border-radius:999px;background:var(--ink);color:var(--bg)}

.picker{padding:clamp(16px,3vw,24px);border-radius:26px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow)}
.tray{display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;justify-content:space-between;padding-bottom:16px;margin-bottom:16px;border-bottom:1px dashed var(--line)}
.tray .picked{display:flex;flex-wrap:wrap;gap:8px;align-items:center;min-width:0;color:var(--ink-2);font-weight:600}
.tray .ctrl{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.seg{display:inline-flex;border:2px solid var(--line);border-radius:999px;overflow:hidden}
.seg button{min-height:40px;padding:0 14px;border:0;background:transparent;cursor:pointer;font-weight:700;font-size:.92rem}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.link{background:none;border:0;padding:8px 6px;cursor:pointer;font-weight:700;color:var(--accent);text-decoration:underline;text-underline-offset:3px}
.grp+.grp{margin-top:18px}
.grp h3{font:700 .78rem var(--f-body);text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2);margin-bottom:10px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{display:inline-flex;align-items:center;gap:7px;min-height:44px;padding:0 14px 0 10px;border-radius:999px;border:2px solid var(--line);background:var(--surface);cursor:pointer;font-weight:700;font-size:.95rem}
.chip .em{font-size:1.35rem;line-height:1}
.chip:hover{border-color:var(--accent)}
.chip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.chip.small{min-height:34px;font-size:.88rem;padding:0 10px 0 8px}
.chip.small .em{font-size:1.1rem}

.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.toolbar select{min-height:44px;padding:0 14px;border-radius:999px;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:700 .95rem var(--f-body)}
.active{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.tagx{display:inline-flex;align-items:center;gap:6px;min-height:34px;padding:0 6px 0 12px;border-radius:999px;border:0;background:color-mix(in srgb,var(--c-berry) 18%,var(--surface));cursor:pointer;font-weight:700;font-size:.9rem}
.tagx b{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--ink);color:var(--bg);font-size:.8rem}
#hasil{scroll-margin-top:84px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.card{position:relative;border-radius:22px;overflow:hidden;background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);transition:transform .15s}
.card:hover{transform:translateY(-3px)}
.card-main{display:block;width:100%;padding:0;border:0;background:none;text-align:start;cursor:pointer}
.art{height:100px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--mc) 24%,var(--surface))}
.art span{width:58px;height:58px;display:grid;place-items:center;border-radius:50%;font-size:2rem;background:color-mix(in srgb,var(--mc) 20%,var(--surface));border:3px solid var(--surface)}
.art span+span{margin-inline-start:-14px}
.meta{padding:14px 16px 16px;display:grid;gap:8px}
.menu-tag{justify-self:start;padding:2px 10px;border-radius:999px;font-weight:700;font-size:.78rem;background:color-mix(in srgb,var(--mc) 22%,var(--surface))}
.meta h3{font-size:1.2rem;font-weight:600}
.ings{display:flex;flex-wrap:wrap;gap:4px 10px;font-size:.88rem;color:var(--ink-2)}
.ings .m{color:var(--ink);font-weight:800;text-decoration:underline;text-decoration-color:var(--accent);text-decoration-thickness:2px;text-underline-offset:3px}
.match{font-weight:800;font-size:.85rem;color:var(--accent)}
.fav{position:absolute;top:10px;inset-inline-end:10px;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--surface);cursor:pointer;font-size:1.3rem;line-height:1;color:var(--ink-2)}
.fav[aria-pressed="true"]{color:var(--accent);border-color:var(--accent)}
.more{display:flex;justify-content:center;margin-top:22px}
.empty{padding:36px 20px;text-align:center;border-radius:24px;border:2px dashed var(--line);color:var(--ink-2)}
.empty .big{font-size:2.6rem}
.empty h3{color:var(--ink);font-size:1.3rem;margin:6px 0}
.empty p{margin:0 auto 16px;max-width:44ch}

.pill{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom,0px));z-index:40;box-shadow:0 10px 30px rgba(0,0,0,.28);max-width:calc(100% - 32px)}

.overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:rgba(20,10,40,.6);padding:12px max(12px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(12px,env(safe-area-inset-left,0px))}
.sheet{width:100%;max-width:640px;max-height:100%;overflow:auto;border-radius:28px;background:var(--surface);border:1px solid var(--line);position:relative}
.sheet-top{padding:24px 20px 20px;background:color-mix(in srgb,var(--mc) 26%,var(--surface))}
.sheet-top .art2{display:flex;margin-bottom:14px}
.sheet-top .art2 span{width:64px;height:64px;display:grid;place-items:center;border-radius:50%;font-size:2.2rem;background:var(--surface);border:3px solid color-mix(in srgb,var(--mc) 26%,var(--surface))}
.sheet-top .art2 span+span{margin-inline-start:-14px}
.sheet-top h2{font-size:clamp(1.7rem,5vw,2.3rem);font-weight:700;line-height:1.05;padding-inline-end:100px}
.sheet-top .tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.tag{padding:3px 12px;border-radius:999px;background:var(--surface);font-weight:700;font-size:.82rem}
.sheet-actions{position:absolute;top:14px;inset-inline-end:14px;display:flex;gap:8px}
.sheet-actions button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:var(--surface);cursor:pointer;font-size:1.2rem;color:var(--ink-2)}
.sheet-actions .fav2[aria-pressed="true"]{color:var(--accent);border-color:var(--accent)}
.sheet-body{padding:20px 20px calc(24px + env(safe-area-inset-bottom,0px));display:grid;gap:22px}
.sheet-body h3{font-size:1.15rem;font-weight:600;margin-bottom:10px}
.ing-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px}
.ing-list li{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:16px;background:var(--surface-2);font-weight:700}
.ing-list .em{font-size:1.5rem}
.ing-list small{display:block;font-weight:600;color:var(--ink-2);font-size:.75rem}
.steps{margin:0;padding-inline-start:1.3rem;display:grid;gap:8px}
.steps li::marker{font-weight:800;color:var(--accent)}
.facts{display:flex;flex-wrap:wrap;gap:8px 18px;color:var(--ink-2);font-weight:700;font-size:.9rem}
.similar{display:flex;flex-wrap:wrap;gap:8px}

footer{margin-top:56px;padding-top:20px;border-top:1px solid var(--line);color:var(--ink-2);font-size:.9rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 20px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

.avoid{padding-bottom:16px;margin-bottom:16px;border-bottom:1px dashed var(--line)}
.avoid h3{font:700 .78rem var(--f-body);text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2);margin-bottom:6px}
.avoid .hint{margin:0 0 10px;color:var(--ink-2);font-size:.9rem}
.chip.warn:hover{border-color:var(--warn)}
.chip.warn[aria-pressed="true"]{background:var(--warn);border-color:var(--warn);color:var(--bg)}
.taste{font-size:.85rem;font-weight:700;color:var(--ink-2)}
.algs{display:flex;flex-wrap:wrap;gap:6px}
.alg{padding:1px 9px;border-radius:999px;font-size:.75rem;font-weight:800;border:1.5px solid var(--warn);color:var(--warn)}
.rasa{margin:0;font-size:.88rem;color:var(--ink-2)}
.rasa b{color:var(--ink)}
.about{margin-bottom:18px;padding:18px;border-radius:22px;display:grid;gap:10px;background:color-mix(in srgb,var(--mc) 14%,var(--surface));border:2px solid color-mix(in srgb,var(--mc) 35%,var(--line))}
.about h3{font-size:1.25rem;font-weight:600}
.about dl{margin:0;display:grid;gap:10px}
.about dt{font-weight:800;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-2)}
.about dd{margin:0}
.warnbox,.okbox{padding:14px 16px;border-radius:18px}
.warnbox{border:2px solid var(--warn);background:color-mix(in srgb,var(--warn) 9%,var(--surface))}
.okbox{border:2px solid var(--line);background:var(--surface-2)}
.warnbox h3{color:var(--warn);margin-bottom:8px}
.okbox h3{margin-bottom:6px}
.warnbox ul,.bul{margin:0;padding-inline-start:1.2rem;display:grid;gap:6px}
.okbox p,.plain{margin:0}
.disc{margin:0;font-size:.82rem;color:var(--ink-2)}
footer .disc{flex-basis:100%}

#kalkulator{scroll-margin-top:84px}
.calc{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:18px;align-items:start}
@media (max-width:860px){.calc{grid-template-columns:minmax(0,1fr)}}
.calc-main,.conv{padding:clamp(16px,3vw,24px);border-radius:26px;background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);min-width:0}
.calc-controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin-bottom:18px}
.cf{display:grid;gap:6px;min-width:0;align-content:start}
.cf-wide{grid-column:1/-1}
.cf label{font:700 .78rem var(--f-body);text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2)}
.cf select,.cf input,.conv-in input,.conv-in select{min-height:44px;padding:0 12px;border-radius:14px;border:2px solid var(--line);background:var(--surface);color:var(--ink);font:700 1rem var(--f-body);width:100%;min-width:0}
.step{display:grid;grid-template-columns:44px minmax(0,1fr) 44px;gap:6px}
.step button{min-height:44px;border-radius:14px;border:2px solid var(--line);background:var(--surface-2);cursor:pointer;font-size:1.3rem;font-weight:800;line-height:1}
.step button:hover{border-color:var(--accent)}
.step input{text-align:center;padding:0 4px}
.chead h3{font-size:1.3rem;font-weight:600;margin-bottom:8px}
.chead .algs{margin-bottom:14px}
.cstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:0 0 16px}
.cstats div{padding:10px 12px;border-radius:16px;background:var(--surface-2)}
.cstats dt{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-2)}
.cstats dd{margin:2px 0 0;font:600 1.2rem/1.2 var(--f-display)}
.cstats dd small{display:block;font:600 .78rem var(--f-body);color:var(--ink-2)}
.clist{list-style:none;margin:0 0 16px;padding:0;display:grid;gap:6px}
.clist li{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:4px 12px;align-items:center;padding:8px 12px;border-radius:14px;background:var(--surface-2)}
.clist .em{font-size:1.5rem}
.clist .nm{font-weight:800;min-width:0}
.clist .nm small,.clist .qty small{display:block;font-weight:600;color:var(--ink-2);font-size:.78rem}
.clist .qty{text-align:end;font-weight:800;font-variant-numeric:tabular-nums}
.cactions{display:flex;flex-wrap:wrap;gap:8px}
.conv h3{font-size:1.3rem;font-weight:600;margin-bottom:10px}
.conv-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:8px;margin:12px 0}
.conv-out{list-style:none;margin:0 0 12px;padding:0;display:grid;gap:6px}
.conv-out li{display:flex;justify-content:space-between;gap:10px;padding:8px 12px;border-radius:14px;background:var(--surface-2);font-weight:700}
.conv-out b{font-variant-numeric:tabular-nums;text-align:end}
.btn.start{justify-self:start}

.hist{margin-top:20px;padding-top:14px;border-top:1px dashed var(--line)}
.hist-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px}
.hist-head h3{font:700 .78rem var(--f-body);text-transform:uppercase;letter-spacing:.1em;color:var(--ink-2)}
.hist-head .link{padding:4px 2px;font-size:.88rem}
.hist-list{display:flex;flex-wrap:wrap;gap:8px}
