const ICE='es krim|eskrim|ice cream|icecream|ice-cream|helado|sorvete|アイスクリーム|아이스크림|冰淇淋|冰激凌|ايس كريم|بوظة';
const DAIRY='susu|dairy|milk|lacteos|laticinios|leche|leite|lactosa|lactose|laktosa|乳製品|牛乳|乳|유제품|우유|乳制品|牛奶|奶|البان|حليب';
const NUTS='kacang|nuts|frutos secos|nueces|castanhas|nozes|ナッツ|견과|坚果|果仁|مكسرات';
const SUGAR='gula|sugar|azucar|acucar|砂糖|설탕|无糖|糖|سكر';
const VEGAN='vegan|vegano|ビーガン|ヴィーガン|비건|纯素|素食|نباتي|nabati';
const isLat=s=>/^[a-z0-9 \-']+$/.test(s);
const reCache={};
function termRe(term,strict){
  const k=(strict?'S':'L')+term;if(reCache[k])return reCache[k];
  const esc2=term.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  return reCache[k]=isLat(term)?new RegExp('(?<![\\p{L}\\p{N}])'+esc2+(strict?'(?:es|s)?(?![\\p{L}])':''),'u'):new RegExp(esc2,'u');
}
const termList=(str,strict)=>str.split('|').map(x=>[nrm(x),strict]).sort((a,b)=>b[0].length-a[0].length);
const ING_TERMS=(()=>{
  const out=[];const seen=new Set();
  Object.keys(ING).forEach(id=>{
    const names=(id==='protein'||id==='susu')?[]:[id];
    Object.keys(I18N).forEach(l=>{const v=I18N[l]['ing.'+id];if(v)names.push(v);});
    if(id==='coklat')names.push('cokelat');
    names.forEach(n=>{const x=nrm(n.replace(/\(.*?\)/g,'')).trim();if(x.length>=2&&!seen.has(x+'|'+id)){seen.add(x+'|'+id);out.push([x,id]);}});
  });
  return out.sort((a,b)=>b[0].length-a[0].length);
})();
const NEGP=/(?<![\p{L}])(?:tanpa|jangan|bukan|tidak|no|not|without|sin|sem|nao|nada de|evita|evite|avoid|free of)(?![\p{L}])|不要|不加|不含|没有|无|別|避免|بدون|بلا|دون/u;
const NEGS=/^(?:[^\s,.;、，。]{0,3}\s*)?(?:なし|抜き|無し|いらない|入れない|없이|없는|빼고|제외|싫|-?\s?free)/u;
const SEP=/[,.;、，。!?！？]|\s(?:tapi|tetapi|but|pero|mas|mais|aber|dengan|with|con|com)\s|但是|但|しかし|لكن|하지만|그런데/g;
function isNeg(txt,s,e){
  let w=txt.slice(Math.max(0,s-18),s),m,last=0;
  SEP.lastIndex=0;while((m=SEP.exec(w)))last=m.index+m[0].length;
  w=w.slice(last);
