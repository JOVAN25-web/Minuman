}
function parseBar(raw){
  let txt=nrm(raw);
  const P={int:{},pos:new Set(),neg:new Set(),exDairy:false,exNuts:false,vegan:false};
  const blank=(s,e)=>{txt=txt.slice(0,s)+' '.repeat(e-s)+txt.slice(e);};
  const scan=(term,strict,fn)=>{const re=termRe(term,strict);let m,g=0;while(g++<6&&(m=re.exec(txt))){const s=m.index,e=s+m[0].length;const ng=isNeg(txt,s,e);blank(s,e);fn(ng,s);}};
  const eachTerm=(str,strict,fn)=>termList(str,strict).forEach(([t0])=>scan(t0,strict,fn));
  eachTerm(ICE,true,(ng,s)=>{
    const pre=txt.slice(Math.max(0,s-14),s);
    if(ng)P.neg.add('eskrim');
    else if(/(?:dengan|pakai|with|con|com|plus)\s*$|[でを와과和加]\s*$|مع\s*$/u.test(pre))P.pos.add('eskrim');
    else P.int.icecream=1;
  });
  ING_TERMS.forEach(([t0,id])=>scan(t0,true,ng=>{(ng?P.neg:P.pos).add(id);}));
  eachTerm(DAIRY,true,ng=>{if(ng)P.exDairy=true;else P.int.creamy=P.int.creamy||1;});
  eachTerm(NUTS,true,ng=>{if(ng)P.exNuts=true;else P.int.nutty=P.int.nutty||1;});
  eachTerm(VEGAN,false,()=>{P.vegan=true;});
  eachTerm(SUGAR,true,ng=>{if(ng)P.int.diet=P.int.diet||1;});
  const all=[];Object.keys(LEX).forEach(id=>LEX[id].split('|').forEach(x=>all.push([nrm(x),id])));
  all.sort((a,b)=>b[0].length-a[0].length).forEach(([t0,id])=>scan(t0,false,ng=>{P.int[id]=ng?-1:1;}));
  P.pos.forEach(i=>{if(P.neg.has(i))P.pos.delete(i);});
  P.n=Object.keys(P.int).length+P.pos.size+P.neg.size+(P.exDairy?1:0)+(P.exNuts?1:0)+(P.vegan?1:0);
  return P;
}
const G=(r,...l)=>r.ings.filter(i=>l.includes(i)).length;
const kc=r=>r._kc!=null?r._kc:(r._kc=calcRows(r,1).kcal);
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const TN=(r,k)=>r.ings.filter(i=>TASTE[i]===k).length;
const SC={
 icecream:r=>2*G(r,'pisang')+2*G(r,'vanila')+1.5*G(r,'santan','yogurt','susu','susuoat','susualmond')+G(r,'alpukat','coklat')+(r.tex==='thick'?1.5:0)+1.5*G(r,'eskrim')+(r.ings.includes('esbatu')?.5:0),
 diet:r=>clamp((380-kc(r))/80,-3,3)-1.5*G(r,'eskrim','madu','coklat','kurma')+.8*G(r,'bayam','brokoli','timun','chia'),
 protein:r=>3*G(r,'protein')+1.5*G(r,'yogurt','kacangtanah','almond','mete','kenari','chia','bunga','oat')+G(r,'susu'),
 sweet:r=>1.2*TN(r,'manis')+G(r,'madu','kurma','eskrim'),
 tangy:r=>1.5*TN(r,'asam')+G(r,'lemon','jeruk','kiwi','nanas'),
 fresh:r=>1.2*TN(r,'segar')+G(r,'mint','timun','lemon','semangka','melon','airkelapa','esbatu')+.7*TN(r,'asam'),
 creamy:r=>1.5*TN(r,'creamy')+(r.tex==='thick'?1.5:0)+G(r,'pisang','alpukat'),
 nutty:r=>2*G(r,'almond','kacangtanah','kenari','mete')+TN(r,'gurih'),
 warm:r=>2*G(r,'jahe','kayumanis','kunyit')+G(r,'vanila','kopi'),
 energy:r=>1.3*G(r,'pisang','kurma','protein','oat','madu','kopi','matcha','mangga','kacangtanah'),
 green:r=>2*G(r,'bayam','brokoli','timun')+G(r,'matcha','tehhijau','mint','wortel'),
 immune:r=>1.5*G(r,'jeruk','lemon','kiwi','jahe','kunyit','stroberi','bayam','brokoli')};
function scoreR(r,P){
  let s=0;
