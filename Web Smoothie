.gctl{display:flex;flex-wrap:wrap;gap:8px}.gctl .btn{min-height:40px;flex:1 1 auto;font-size:.85rem;padding:0 12px}
@media (max-width:760px){.hero{grid-template-columns:minmax(0,1fr)}.arena{align-self:stretch}}

/* ===== v12: entry gate ===== */
.gate{position:fixed;inset:0;z-index:65;overflow:auto;background:var(--bg);padding:76px max(14px,env(safe-area-inset-right)) 24px max(14px,env(safe-area-inset-left));display:grid;align-content:start}
