@media (prefers-reduced-motion:no-preference){.cta{animation:ctaGlow 2.6s ease-in-out infinite}@keyframes ctaGlow{50%{box-shadow:0 14px 34px color-mix(in srgb,var(--c-pink) 62%,transparent),inset 0 -4px 0 rgba(0,0,0,.12)}}}
.arena{display:grid;gap:12px;padding:18px;border-radius:24px;background:color-mix(in srgb,var(--surface) 78%,transparent);backdrop-filter:blur(6px);border:2px solid color-mix(in srgb,var(--c-pink) 30%,var(--line));align-self:center}
