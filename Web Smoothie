    c.restore();c.restore();
  });
  c.globalAlpha=1;
  GM.parts.forEach(p=>{c.globalAlpha=Math.max(0,1-p.t/p.life);c.fillStyle=p.c;c.beginPath();c.arc(p.x,p.y,p.r,0,7);c.fill();});
  c.globalAlpha=1;
  c.font=`800 20px ${fv('--f-num')}`;
  GM.pops.forEach(p=>{c.globalAlpha=Math.max(0,1-p.t/.8);c.fillStyle=p.c;c.strokeStyle='#fff';c.lineWidth=4;c.strokeText(p.txt,p.x,p.y-p.t*50);c.fillText(p.txt,p.x,p.y-p.t*50);});
  c.globalAlpha=1;
  const now=performance.now();GM.trail=GM.trail.filter(p=>now-p.t<220);
  if(GM.trail.length>1){
    c.lineCap='round';c.shadowColor='#ff5ea3';c.shadowBlur=14;
    for(let i=1;i<GM.trail.length;i++){const a=1-(now-GM.trail[i].t)/220;c.strokeStyle=`rgba(255,255,255,${Math.max(0,a)})`;c.lineWidth=2+a*6;c.beginPath();c.moveTo(GM.trail[i-1].x,GM.trail[i-1].y);c.lineTo(GM.trail[i].x,GM.trail[i].y);c.stroke();}
    c.shadowBlur=0;
  }
}
function gTick(ts){
  GM.raf=0;
  const act=gActive();
  if(!act&&!GM.fruits.length&&!GM.halves.length&&!GM.parts.length&&!GM.splats.length&&!GM.pops.length){gx.clearRect(0,0,GM.w,GM.h);return;}
  const dt=Math.min(.05,(ts-(GM.last||ts))/1000);GM.last=ts;
  if(act){GM.spawnT-=dt;if(GM.spawnT<=0){gSpawn();if(Math.random()<.3)gSpawn();GM.spawnT=rnd2(.55,1.05)*(GM.w<600?1.25:1);}}
  GM.fruits.forEach(f=>{f.vy+=f.g*dt;f.x+=f.vx*dt;f.y+=f.vy*dt;f.rot+=f.vr*dt;});
  GM.fruits=GM.fruits.filter(f=>f.y<GM.h+60&&f.x>-80&&f.x<GM.w+80);
  GM.halves.forEach(h=>{h.vy+=720*dt;h.x+=h.vx*dt;h.y+=h.vy*dt;h.rot+=h.vr*dt;h.life+=dt;});
  GM.halves=GM.halves.filter(h=>h.y<GM.h+60&&h.life<1.6);
  GM.parts.forEach(p=>{p.vy+=900*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.t+=dt;});GM.parts=GM.parts.filter(p=>p.t<p.life);
  GM.splats.forEach(s=>{s.t+=dt;});GM.splats=GM.splats.filter(s=>s.t<.5);
  GM.pops.forEach(p=>{p.t+=dt;});GM.pops=GM.pops.filter(p=>p.t<.8);
  if(GM.combo&&performance.now()-GM.lastCut>1200){GM.combo=0;gHud();}
  gDraw();
  GM.raf=requestAnimationFrame(gTick);
}
function gGate(){if(!GM.raf){GM.last=0;GM.raf=requestAnimationFrame(gTick);}}
setInterval(()=>{if(gActive())gGate();},500);
document.addEventListener('visibilitychange',()=>{if(!document.hidden)gGate();});
function renderGameCtl(){
  const p=$('gPause');p.textContent=(GM.paused?'▶ ':'⏸ ')+t(GM.paused?'game.play':'game.pause');p.setAttribute('aria-pressed',String(GM.paused));
  const s=$('gSnd');s.textContent=(GM.snd?'🔊 ':'🔇 ')+t('game.sound');s.setAttribute('aria-pressed',String(GM.snd));
  gHud();
}
$('gPause').addEventListener('click',()=>{
  GM.paused=!GM.paused;
  if(GM.paused){GM.fruits=[];GM.halves=[];GM.parts=[];GM.splats=[];GM.pops=[];GM.trail=[];}
  renderGameCtl();gGate();
});
$('gSnd').addEventListener('click',()=>{GM.snd=!GM.snd;try{localStorage.setItem('smoosh:slash:snd',GM.snd?'1':'0');}catch(e){}renderGameCtl();if(GM.snd){ensureAudio();gSound(1);}});
/* entry gate: the welcome screen sits apart from the app; entering opens the pages */
let userName='';try{userName=(localStorage.getItem('smoosh:name')||'').slice(0,30);}catch(e){}
function renderHome(){$('homeHi').textContent=userName?t('home.hi',{n:userName}):t('home.hi0');}
function openGate(){
  $('gate').classList.remove('leaving');$('gate').hidden=false;$('stage').inert=true;$('tabs').inert=true;
  $('gName').value=userName;gResize();gGate();
}
function enterApp(toPage){
  userName=$('gName').value.trim().slice(0,30);
  try{localStorage.setItem('smoosh:name',userName);sessionStorage.setItem('smoosh:in','1');}catch(e){}
  renderHome();
  const g=$('gate');
  const done=()=>{g.hidden=true;g.classList.remove('leaving');$('stage').inert=false;$('tabs').inert=false;setPage(PG(toPage),{push:true});const h=document.querySelector('.page.on h1,.page.on h2');if(h){h.setAttribute('tabindex','-1');h.focus({preventScroll:true});}};
  if(reduce){done();return;}
  g.classList.add('leaving');setTimeout(done,520);
}
$('gateForm').addEventListener('submit',e=>{e.preventDefault();enterApp('beranda');});
$('ctaBuild').addEventListener('click',()=>enterApp('racik'));
document.querySelector('.logo').addEventListener('click',e=>{if(cur===PG('beranda')&&$('gate').hidden){e.preventDefault();openGate();}});
if(/[?&]debug\b/.test(location.search))window.__slash=GM;
gResize();renderGameCtl();gGate();

/* ---------- theme + language menus ---------- */
let popMode=null,theme='auto';
function setTheme(c){
  theme=c;const root=document.documentElement;
  if(c==='auto')root.removeAttribute('data-theme');else root.setAttribute('data-theme',c);
  try{localStorage.setItem('smoosh:theme',c);}catch(e){}
}
function closePop(back){
  if(!popMode)return;
  const b=popMode==='lang'?$('langBtn'):$('themeBtn');
  popMode=null;$('pop').hidden=true;$('pop').innerHTML='';
  $('langBtn').setAttribute('aria-expanded','false');$('themeBtn').setAttribute('aria-expanded','false');
  if(back)b.focus();
}
function renderPop(){
  if(!popMode)return;
  const items=popMode==='lang'
    ?LANGS.map(l=>`<button type="button" class="opt" role="radio" aria-checked="${l.c===lang}" data-lang="${l.c}" lang="${l.c}"><span class="code" aria-hidden="true">${l.s}</span><span>${l.n}</span>${l.c===lang?'<span class="ck" aria-hidden="true">✓</span>':''}</button>`).join('')
    :THEMES.map(h=>`<button type="button" class="opt" role="radio" aria-checked="${h.c===theme}" data-theme-opt="${h.c}"><span class="sw" style="background:${h.sw}" aria-hidden="true"></span><span>${t(h.k)}</span>${h.c===theme?'<span class="ck" aria-hidden="true">✓</span>':''}</button>`).join('');
  $('pop').innerHTML=`<h3>${t(popMode==='lang'?'lang.label':'theme.label')}</h3><div role="radiogroup" aria-label="${esc(t(popMode==='lang'?'lang.label':'theme.label'))}">${items}</div>${popMode==='theme'?`<button type="button" class="opt snd" role="switch" aria-checked="${sndOn}" data-snd><span class="code" aria-hidden="true">${sndOn?'🔊':'🔇'}</span><span>${t('snd.label')}</span></button>`:''}`;
}
function openPop(mode,btn){
  if(popMode===mode){closePop(true);return;}
  popMode=mode;renderPop();$('pop').hidden=false;
  $('langBtn').setAttribute('aria-expanded',String(btn===$('langBtn')));$('themeBtn').setAttribute('aria-expanded',String(btn===$('themeBtn')));
  const c=$('pop').querySelector('[aria-checked="true"]');if(c)c.focus();
}
$('langBtn').addEventListener('click',e=>openPop('lang',e.currentTarget));
$('themeBtn').addEventListener('click',e=>openPop('theme',e.currentTarget));
$('pop').addEventListener('click',e=>{
  const l=e.target.closest('[data-lang]');if(l){setLang(l.dataset.lang);closePop(true);return;}
  if(e.target.closest('[data-snd]')){toggleSound();renderPop();const c=$('pop').querySelector('[data-snd]');if(c)c.focus();return;}
  const h=e.target.closest('[data-theme-opt]');if(h){setTheme(h.dataset.themeOpt);renderPop();const c=$('pop').querySelector('[aria-checked="true"]');if(c)c.focus();}
});
document.addEventListener('click',e=>{if(popMode&&!e.target.closest('#pop,#langBtn,#themeBtn'))closePop(false);});
document.addEventListener('keydown',e=>{
  if(!popMode)return;
  if(e.key==='Escape'){closePop(true);return;}
  if(e.key==='ArrowDown'||e.key==='ArrowUp'){
    const o=[...$('pop').querySelectorAll('.opt')];const i=o.indexOf(document.activeElement);
    if(!o.length)return;e.preventDefault();
    o[(i+(e.key==='ArrowDown'?1:-1)+o.length)%o.length].focus();
  }
});

/* ---------- apply language ---------- */
function applyStatic(){
  document.querySelectorAll('[data-i]').forEach(e=>{e.textContent=t(e.dataset.i);});
  document.querySelectorAll('[data-ih]').forEach(e=>{e.innerHTML=t(e.dataset.ih);});
  document.querySelectorAll('[data-ph]').forEach(e=>{e.placeholder=t(e.dataset.ph);});
  document.querySelectorAll('[data-aria]').forEach(e=>{e.setAttribute('aria-label',t(e.dataset.aria));});
  document.querySelectorAll('[data-title]').forEach(e=>{e.title=t(e.dataset.title);});
}
const LANG_FONTS={ar:['Cairo:wght@500;700','Baloo+Bhaijaan+2:wght@600;700','Aref+Ruqaa:wght@700'],ja:['Mochiy+Pop+One','M+PLUS+Rounded+1c:wght@500;700','Zen+Maru+Gothic:wght@500;700','Yomogi'],ko:['Jua','Gowun+Dodum','Gaegu:wght@700'],zh:['ZCOOL+KuaiLe','Noto+Sans+SC:wght@500;700','Ma+Shan+Zheng']};
function loadLangFonts(c){
  (LANG_FONTS[c]||[]).forEach(f=>{
    const id='lf-'+f.split(':')[0];if(document.getElementById(id))return;
    const l=document.createElement('link');l.id=id;l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family='+f+'&display=swap';document.head.appendChild(l);
  });
}
function setLang(c){
  lang=LANGS.some(x=>x.c===c)?c:'id';
  const l=L();
  document.documentElement.lang=lang;document.documentElement.dir=l.dir;loadLangFonts(lang);
  try{localStorage.setItem('smoosh:lang',lang);}catch(e){}
  $('langCode').textContent=l.s;
  if(rec&&listening){try{rec.abort();}catch(e){}}
  setVoiceMsg('');
  applyStatic();buildHay();
  renderTry();fillFrom();renderConv();
  refreshCustomNames();fillCalcOptions();
  renderMenus();renderGroups();renderAvoid();renderTray();renderResults();renderHist();renderCalc();renderBuilder();
  renderIde();renderTimer();renderGameCtl();renderHome();if(!$('kitchen').hidden)renderKitchen();if(!$('overlay2').hidden)renderShare();
  if(!$('overlay').hidden&&curDetail)openDetail(curDetail,lastFocus,true);
  renderPop();
}

/* ---------- init ---------- */
try{const sl=localStorage.getItem('smoosh:lang');if(LANGS.some(x=>x.c===sl))lang=sl;}catch(e){}
try{const st=localStorage.getItem('smoosh:theme');if(THEMES.some(x=>x.c===st)){theme=st;if(st!=='auto')setTheme(st);}}catch(e){}
renderFavCount();
setLang(lang);
{const i=PAGES.indexOf(location.hash.slice(1));setPage(i<0?0:i,{push:false,instant:true});}
if(parseHash())hashNav();
else{let seen=false;try{seen=sessionStorage.getItem('smoosh:in')==='1';}catch(e){}
  if(!seen)openGate();}
})();
</script>

