    const st=BST[bs.step],id=chip.dataset.b,sel=bs[st.k];
    bMsgKey=null;
    if(sel.includes(id))bs[st.k]=sel.filter(x=>x!==id);
    else if(st.max===1)bs[st.k]=[id];
    else if(sel.length>=st.max)bMsgKey={k:'b.max',p:{n:st.max}};
    else sel.push(id);
    renderBuilder(id);return;
  }
