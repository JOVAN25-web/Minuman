  box-shadow:0 10px 26px color-mix(in srgb,var(--c-pink) 45%,transparent),inset 0 -4px 0 rgba(0,0,0,.12);
  transition:transform .25s cubic-bezier(.2,1.4,.4,1),box-shadow .25s,background-position .6s}
.cta::after{content:"";position:absolute;inset-block:0;inset-inline-start:-60%;width:40%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.55),transparent);transform:skewX(-20deg);transition:inset-inline-start .7s}
.cta:hover,.cta:focus-visible{transform:translateY(-4px) scale(1.04);background-position:100% 0;box-shadow:0 16px 34px color-mix(in srgb,var(--c-pink) 55%,transparent),inset 0 -4px 0 rgba(0,0,0,.12)}
