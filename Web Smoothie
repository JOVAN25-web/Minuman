  if(e.target.closest('#bRestart')){bs.step=0;bs.base=[];bs.fruit=[];bs.green=[];bs.boost=[];bMsgKey=null;renderBuilder();return;}
  if(e.target.closest('#bOpen')){const cr=registerCustom(buildCustom().ings,'b');openDetail(cr.id,e.target);return;}
