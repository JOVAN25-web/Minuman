/* ---------- extras: barista (rule-based, offline) ---------- */
const nrm=s=>String(s).toLowerCase().normalize('NFD').replace(/[̀-ًͯ-ٰٟـ]/g,'').normalize('NFC').replace(/\s+/g,' ');
const LEX={
