.hud>div{padding:10px;border-radius:16px;background:var(--surface);border:2px solid var(--line);text-align:center}
.hud small{display:block;color:var(--ink-2);font:700 .72rem var(--f-display);text-transform:uppercase;letter-spacing:.08em}
