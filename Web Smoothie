/* ---------- pager ---------- */
const track=$('track'),stage=$('stage'),pages=[...document.querySelectorAll('.page')];
function setPage(i,o){
  o=o||{};
  i=Math.max(0,Math.min(PAGES.length-1,i));const was=cur;
  if(i!==was)track.dataset.dir=i>was?'next':'prev';
  cur=i;
  if(o.instant)track.style.transition='none';
  track.style.transform=`translateX(${-i*100}%)`;
  if(o.instant){void track.offsetWidth;track.style.transition='';}
  pages.forEach((p,k)=>{p.classList.toggle('on',k===i);p.inert=k!==i;});
  if(i!==was){const p=pages[i];p.scrollTop=0;p.classList.add('fresh');clearTimeout(p._t);p._t=setTimeout(()=>p.classList.remove('fresh'),1200);}
  document.querySelectorAll('[data-go]').forEach(b=>{if(+b.dataset.go===i)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');});
  $('tabs').querySelector('.tabs-in').style.setProperty('--i',i);
  if(o.push!==false){try{if(location.hash!=='#'+PAGES[i])location.hash=PAGES[i];}catch(e){}}
  updatePill();
}
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>setPage(+b.dataset.go)));
window.addEventListener('hashchange',()=>hashNav());
let tx=0,ty=0,dx=0,mode=null,touching=false,slashTouch=false;
stage.addEventListener('touchstart',e=>{
  if(e.touches.length!==1||slashTouch){touching=false;return;}
  const p=e.touches[0];tx=p.clientX;ty=p.clientY;dx=0;mode=null;touching=true;
},{passive:true});
stage.addEventListener('touchmove',e=>{
  if(!touching)return;
  const p=e.touches[0];dx=p.clientX-tx;const dy=p.clientY-ty;
  if(mode===null&&(Math.abs(dx)>8||Math.abs(dy)>8))mode=Math.abs(dx)>Math.abs(dy)*1.3?'h':'v';
  if(mode==='h'){
    track.classList.add('drag');
    const edge=(cur===0&&dx>0)||(cur===PAGES.length-1&&dx<0);
    track.style.transform=`translateX(calc(${-cur*100}% + ${edge?dx*.3:dx}px))`;
  }
},{passive:true});
function endTouch(cancel){
  if(!touching)return;touching=false;
  if(mode==='h'){
    track.classList.remove('drag');
    const need=Math.min(90,stage.clientWidth*.2);
    if(!cancel&&Math.abs(dx)>need)setPage(cur+(dx<0?1:-1));else setPage(cur,{push:false});
  }
  mode=null;
}
stage.addEventListener('touchend',()=>endTouch(false));
stage.addEventListener('touchcancel',()=>endTouch(true));
let wheelLock=false;
stage.addEventListener('wheel',e=>{
  if(wheelLock||Math.abs(e.deltaX)<=Math.abs(e.deltaY)||Math.abs(e.deltaX)<30)return;
  wheelLock=true;setPage(cur+(e.deltaX>0?1:-1));setTimeout(()=>{wheelLock=false;},800);
},{passive:true});
document.addEventListener('keydown',e=>{
  if(!$('overlay').hidden||!$('overlay2').hidden||!$('kitchen').hidden||!$('gate').hidden||popMode||e.altKey||e.ctrlKey||e.metaKey||e.shiftKey)return;
  if(/^(INPUT|SELECT|TEXTAREA)$/.test(e.target.tagName))return;
  if(e.key==='ArrowRight')setPage(cur+1);else if(e.key==='ArrowLeft')setPage(cur-1);
});
